#!/bin/sh

# Energy Dashboard kiosk — launched by labwc at login.
# Waits for the Flask server (systemd service) to be ready, then opens
# Chromium in fullscreen kiosk mode with touch events enabled.

for i in $(seq 1 30); do
  if curl -sf http://localhost:5005/ >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

chromium --kiosk --noerrdialogs --disable-pinch --touch-events=enabled \
  --disable-infobars --check-for-update-interval=315360000 \
  http://localhost:5005
