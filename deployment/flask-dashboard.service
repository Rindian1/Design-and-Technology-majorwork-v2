[Unit]
Description=Energy Dashboard Flask server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
ExecStart=__REPO_DIR__/venv/bin/python run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
